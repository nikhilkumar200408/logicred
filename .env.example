# Copy to .env for local work. NEVER commit a real .env. On Vercel set these under Project Settings > Environment Variables.
# Neon: use the POOLED connection string (host contains "-pooler") with sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Optional: enables POST /api/bootstrap for creating the first administrator. Remove after use.
BOOTSTRAP_TOKEN=
# Public Evaluation Workspace (synthetic data only). Set to false to disable.
ENABLE_EVALUATION_WORKSPACE=true
EVAL_ROW_CAP=3000
# Optional integrations (none are implemented; setting these only changes the status label on Integration Health)
APAAR_API_URL=
ABC_API_URL=
DIGILOCKER_API_URL=
AICTE_API_URL=
ERP_API_URL=
