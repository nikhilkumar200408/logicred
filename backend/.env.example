# MongoDB — a local `mongod` on the default port needs zero extra config.
# For Atlas / Docker Compose, replace with your connection string, e.g.
# mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=logicred_db

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password hashing: bcrypt (default) or argon2
PASSWORD_HASH_SCHEME=bcrypt

# AI / OCR providers. Leave as "demo" to use built-in deterministic providers
# (no external calls, no API keys needed, works fully offline). Switch to
# real providers by setting these once keys/services are available.
LLM_PROVIDER=demo        # demo | anthropic | openai
LLM_API_KEY=
OCR_PROVIDER=demo        # demo | paddleocr

# App
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# --- Real OCR pipeline (see services/ocr/tesseract_provider.py) ---
# Requires system packages: tesseract-ocr tesseract-ocr-hin tesseract-ocr-kan
# poppler-utils (Ubuntu/Debian: apt-get install ...). OCR_PROVIDER=demo is
# still available as an offline fallback for local dev without those
# packages installed, but is not used by default.
EXTRACTION_PROVIDER=regex   # demo | regex | llm
TRANSLATE_ENABLED=true      # deep-translator; requires outbound internet, degrades gracefully if unreachable

# --- Notifications: fired when a record scores anomaly_level=HIGH ---
NOTIFICATIONS_ENABLED=false
# Email (SMTP) — e.g. Gmail with an App Password (NOT your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# SMS — pick ONE provider and fill its keys. Genuine delivery requires a
# real account with that provider; nothing is sent (and none is faked) if
# left blank.
SMS_PROVIDER=none          # none | fast2sms | twilio
NOTIFY_PHONE_NUMBER=
FAST2SMS_API_KEY=          # https://www.fast2sms.com -> Dev API -> API Key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
